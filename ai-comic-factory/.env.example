# =============================================================================
# AI COMIC FACTORY - Environment Configuration (Zero-Cost Local First)
# =============================================================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
SQLITE_DB_PATH=./backend/database/comic_factory.db

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180

# ComfyUI (Local Image Generation)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=dreamshaper_8.safetensors
COMFYUI_WIDTH=1080
COMFYUI_HEIGHT=1350
COMFYUI_STEPS=25
COMFYUI_CFG=7.5
COMFYUI_ENABLE_FALLBACK_RENDERER=true

# Instagram Graph API (Official - supports INSTAGRAM_* or IG_* variable names)
IG_ACCESS_TOKEN=
IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Media Hosting (zero-cost options: local_tunnel | cloudflare_r2 | local)
MEDIA_HOSTING_PROVIDER=local
# Optional Cloudflare R2 (Free tier: 10 GB storage/month, 1M Class A ops, 10M Class B ops)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-comic-factory
R2_PUBLIC_URL=
# Optional Cloudflare Tunnel public URL (e.g. https://comics.yourdomain.com)
CLOUDFLARE_TUNNEL_URL=

# Automation & Scheduling
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
DEFAULT_CAROUSEL_POST_HOUR=10
DEFAULT_INDIVIDUAL_POST_HOUR=18
N8N_WEBHOOK_URL=http://localhost:5678/webhook/comic-factory
N8N_API_KEY=

# Security
ADMIN_API_KEY=change-me-local-secret
